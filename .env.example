# Copie para .env e preencha com a connection string do seu ambiente (dev/hom/prod).
# Nunca coloque a URL real deste arquivo — ele é versionado.
#
# Formato (Session pooler do Supabase — não o Transaction pooler, porta 6543):
# postgresql://<role>.<project-ref>:<senha>@<host>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL=

# Nome do schema Postgres esperado (dev|hom|prod). A aplicação recusa subir
# se current_schema() não bater com isto — proteção contra .env trocado.
DB_SCHEMA_ESPERADO=dev

PORT=3000
NODE_ENV=development
