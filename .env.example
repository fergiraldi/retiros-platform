# Copie para .env e preencha com a connection string do seu ambiente (dev/hom/prod).
# Nunca coloque a URL real deste arquivo — ele é versionado.
#
# Formato (Session pooler do Supabase — não o Transaction pooler, porta 6543):
# postgresql://<role>.<project-ref>:<senha>@<host>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL=

# Nome do schema Postgres esperado (dev|hom|prod). A aplicação recusa subir
# se current_schema() não bater com isto — proteção contra .env trocado.
DB_SCHEMA_ESPERADO=dev

PORT=3000
NODE_ENV=development

# Host da área do operador (PRD §8.1). Entrada fixa da resolução por host e da
# lista de Access-Control-Allow-Origin, fora dos dois conjuntos dinâmicos de
# inquilino. Vazio = nenhum host de operador reconhecido.
HOST_OPERADOR=

# Saltos de proxy confiáveis (`trust proxy` do Express). 0 no dev local, que
# fala direto com o processo; 1 na Railway. Sem isto, req.hostname ignora
# X-Forwarded-Host e a resolução por host recebe o host interno do container.
PROXIES_CONFIAVEIS=0
